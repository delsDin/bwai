# Configuration locale du prototype BWAI 2026 - Cas 1 : Recouvrement
# Aucun secret reel ni cle d'API externe payante n'est requis (fonctionnement 100% hors-ligne).

BWAI_REFERENCE_DATE=2026-03-15
BWAI_HIGH_AMOUNT_THRESHOLD=500000.0
BWAI_AI_CONFIDENCE_THRESHOLD=0.75
BWAI_DEFAULT_CHANNEL=WHATSAPP
BWAI_MIN_DAYS_BETWEEN_REMINDERS=7
BWAI_MAX_REMINDERS_PER_INVOICE=3

# Jetons de test RBAC (les valeurs hachees en SHA-256 sont comparees dans la table SQLite users)
BWAI_TOKEN_GESTIONNAIRE=tok-gestionnaire-koffi
BWAI_TOKEN_VALIDATEUR_1=tok-validateur-amina
BWAI_TOKEN_VALIDATEUR_2=tok-validateur-boris
BWAI_TOKEN_ADMIN=tok-admin-direction
